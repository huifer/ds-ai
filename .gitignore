# ---- secrets ----
.env
.env.local
.env.*.local

# ---- runtime logs ----
logs/*.log
logs/orchestrator.log
logs/launchd.*.log

# ---- pi sessions ----
sessions/
data/multi-agent-sessions/      # 多 Agent 系统 Session 持久化

# ---- generated data (本地沉淀,可重建) ----
data/rss/
data/daily-summary/
data/memory/                       # 长期记忆:JSON+MD(本地状态,人工/git 都可读)
data/memory/mongo/                # MongoDB WiredTiger + journal(本地状态,量大)
data/memory/backups/              # mongodump 输出(可选)
data/memory/stats.json
data/memory/*.log

# ---- node ----
node_modules/
npm-debug.log*

# ---- symlinks(用户特定) ----
links/

# ---- legacy 旧版本仓库----
# 只跟踪源码 + 文档;node_modules / logs / .env 跳过
legacy/**/node_modules/
legacy/**/logs/
legacy/**/.env
legacy/**/.env.local
legacy/**/package-lock.json

# ---- os ----
.DS_Store
.idea/
.vscode/
*.swp
# ---- Pi Agent 探索产生的"野生"文件(黑名单,被 add 时强制跳过)----
# 任何 extensions/*-tools*.mjs / extensions/*-shared.mjs
# 任何 src/jobs/discover.mjs / gh-daily.mjs / discover-tools.mjs
extensions/discover-tools.mjs
extensions/discover-tools-shared.mjs
extensions/gh-tools.mjs
extensions/gh-tools-shared.mjs
extensions/find-skills.mjs
extensions/tavily-*.mjs
src/jobs/discover.mjs
src/jobs/gh-daily.mjs
src/jobs/find-skills.mjs
src/jobs/tavily-*.mjs
scripts/find-skills.mjs
scripts/tavily-*.mjs
