# =====================================================
# ds-ai .gitignore
# 适用于：Python (主) + Jupyter + Markdown 文档项目
# =====================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
.venv/
venv/
ENV/
env/
.conda/

# 测试 / 覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.cache/

# 类型检查
.mypy_cache/
.pyre/
.pytype/

# 格式化 / Lint
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# ---------- 文档 / 构建 ----------
# MkDocs
/site/
/docs/_build/

# Sphinx
docs/_build/
docs/.doctrees/

# 临时草稿
*.tmp
*.bak
*.draft.md

# ---------- 数据 / 模型（大文件） ----------
# 视情况把 data/、models/ 加进来；这里只忽略典型大文件
*.pt
*.pth
*.onnx
*.bin
*.safetensors
*.h5
*.hdf5
*.parquet
*.arrow
*.pkl
*.npy
*.npz

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pip-log.txt

# ---------- 环境变量 / 密钥 ----------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ---------- OS ----------
.DS_Store
.AppleDouble
.LSOverride
Icon?
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- 项目自定义 ----------
# 生成的图示
assets/generated/
# 本地笔记
notes/
scratch/