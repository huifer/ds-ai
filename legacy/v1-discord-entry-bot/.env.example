# ⚠️ 这是 v1 的历史 .env 模板(已废弃)
# 当前生效的 .env 在 ~/pi-discord-agents/.env
# 本文件仅保留以方便对比 v1 / v2 配置差异

# Discord
DISCORD_TOKEN=<REDACTED-v1-token>

# 7 个 channel ID(已迁移到 v2,新增 2 个:CH_RSS, CH_DAILY)
CH_ENTRY=
CH_MEMORY=
CH_IDEAS=
CH_BUILD=
CH_JOURNAL=
CH_SIGNAL=
CH_SYSTEM=

# LLM(v1 直接调 API,不走 Pi Agent)
MINIMAX_API_KEY=<REDACTED-v1-key>
LLM_ENDPOINT=https://api.minimaxi.com/anthropic
LLM_MODEL=MiniMax-M3
LLM_MAX_TOKENS=1024

# 历史消息保留条数
HISTORY_LIMIT=50
OPENAI_API_KEY=<REDACTED>
OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
