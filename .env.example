# ~/pi-discord-bridge/.env.example
# 把这个文件复制成 .env 并填好实际值

# Discord Bot Token(必须)
DISCORD_TOKEN=

# 白名单用户 ID(逗号分隔,空表示所有人)
ALLOWED_USER_IDS=

# 你的 Guild(Server)ID(用于诊断消息用)
GUILD_ID=

# 9 个 channel 的 ID(必须)
# 在 Discord 频道右键 → 复制频道 ID
# 由 scripts/create-channels.mjs 自动建好并写入
CH_ENTRY=              # 主入口(唯一对话的位置)
CH_MEMORY=             # 🧠 记忆库
CH_IDEAS=              # ✨ 灵感
CH_BUILD=              # 🔨 工程
CH_JOURNAL=            # 🌿 日记
CH_SIGNAL=             # 📡 发现(24/7 信号)
CH_SYSTEM=             # 🛠 系统(告警)
CH_RSS=                # 📰 资讯(RSS hub 推送,每天 12:00 北京时间)
CH_DAILY=              # 🌙 每日总结(每天 23:00 北京时间)

# 自动启动(默认 true),设 false 需手动 /orchestrator start
ORCHESTRATOR_AUTOSTART=true

# Pi Agent 模型(可选,默认走 settings.json 里的 defaultModel/defaultProvider)
# PI_PROVIDER=
# PI_MODEL=
