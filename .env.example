# ~/pi-discord-agents/.env.example
# 把这个文件复制成 .env 并填好实际值

# Discord Bot Token(必须)
DISCORD_TOKEN=

# 白名单用户 ID(逗号分隔,空表示所有人)
ALLOWED_USER_IDS=

# 你的 Guild(Server)ID(用于诊断消息用)
GUILD_ID=

# 10 个项目 channel 的 ID
# 在 Discord 频道右键 → 复制频道 ID
CH_ENTRY=              # 📝 主入口(唯一对话的位置)
CH_MEMORY=             # 🧠 记忆库
CH_IDEAS=              # ✨ 灵感
CH_BUILD=              # 🔨 工程
CH_SYSTEM=             # 🛠 系统(告警 / 诊断)
CH_RSS=                # 📰 资讯(RSS hub,每天 12:00 北京时间)
CH_DAILY=              # 🌙 每日总结(每天 23:00 北京时间)
CH_GH=                 # 🎯 每日任务(GitHub issues,每天 10:00 北京时间)
CH_USAGE=              # 📊 用量(Token 报告,每天 12:30 北京时间)
CH_OPPORTUNITY=        # 💡 机会(发现归档 + 机会调研 brief)
CH_XIASI=              # 🌙 遐思(梦境产物推送,先建好频道再填 ID)

# 「遐思」配置(全部默认 false / 默认值,不设就是关闭)
XIASI_ENABLED=false              # true 启用,false 关闭(默认)
XIASI_SILENT=false               # true 只推完成/失败,不推开始
XIASI_TYPES=lian-zhu,gui-cang,ming-tai   # 允许跑的 type,逗号分隔
XIASI_DAILY_TOKEN_BUDGET=5000000  # 每日 token 上限
XIASI_FEED_CONTEXT=false         # 是否让 artifacts 反向参与 memory-context 检索
XIASI_TZ_OFFSET=8                # 时区偏移(小时)

# ===== 遐思增强配置(v3) =====
# 好梦模式:生成正向、激励性洞察
XIASI_GOOD_DREAM_ENABLED=false   # true 启用好梦机制

# 噩梦干预:自动检测并替换负面洞察
XIASI_NIGHTMARE_MITIGATION=true  # true 启用噩梦干预
XIASI_NIGHTMARE_THRESHOLD=-0.2  # 干预阈值(-1到1,低于此值触发干预)

# 梦境→记忆:高分产物自动沉淀到记忆系统
XIASI_DREAM_TO_MEMORY=false     # true 启用自动吸收
XIASI_QUALITY_THRESHOLD=0.60    # 吸收阈值(总分)

# 投票反馈:分析投票数据生成改进信号
XIASI_VOTE_FEEDBACK=false       # true 启用投票分析

# 自我改进:基于历史数据自动优化
XIASI_SELF_IMPROVE=false        # true 启用自我改进

# 自动启动(默认 true),设 false 需手动 /orchestrator start
ORCHESTRATOR_AUTOSTART=true

# Pi Agent 模型(可选,默认走 settings.json 里的 defaultModel/defaultProvider)
# PI_PROVIDER=
# PI_MODEL=

# ===== Connection 系统(第三方服务接入) =====
# OAuth 服务器端口
OAUTH_PORT=3000

# Strava API (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/auth/strava/callback

# ===== 多 Agent 系统(2026-07 启用) =====
# 设为 false 回到单一 Agent 模式
MULTI_AGENT_ENABLED=true

# Session 自动压缩配置
SESSION_MAX_TURNS=20                  # 最大对话轮数
SESSION_MAX_TOKENS=60000              # 最大 tokens
SESSION_KEEP_RECENT=5                 # 压缩后保留最近几轮
SESSION_IDLE_MINUTES=30               # 空闲多少分钟后自动结束
SESSION_PERSIST_DIR=data/multi-agent-sessions  # Session 持久化目录
